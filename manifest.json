{
  "manifest_version": 3,
  "name": "LLamaTubeMusic",
  "version": "0.1.2",
  "description": "Winamp-style overlay for YouTube Music. Controls YTM playback; it does not replace it.",
  "permissions": ["storage"],
  "background": { "service_worker": "dist/background.js" },
  "action": { "default_title": "Show or hide LLamaTubeMusic" },
  "commands": {
    "toggle-window": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Show or hide LLamaTubeMusic"
    }
  },
  "host_permissions": ["https://music.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["dist/bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
