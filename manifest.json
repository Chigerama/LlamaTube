{
  "manifest_version": 3,
  "name": "LLamaTubeMusic",
  "version": "0.1.0",
  "description": "Winamp-style overlay for YouTube Music. Controls YTM playback; it does not replace it.",
  "permissions": ["storage"],
  "host_permissions": ["https://music.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["dist/bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
